{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sean-Koval/flightdeck/src/flightdeck/metrics/weekly.schema.json",
  "title": "flightdeck.weekly/v1",
  "description": "The weekly team metrics (docs/metrics.md), written to <reports>/weekly/<week>.json and latest.json. Hangar's standup line and digest read it and never recompute. Additive within v1.",
  "type": "object",
  "required": ["schema", "week", "start", "end", "scope", "metrics", "trailing"],
  "properties": {
    "schema": {"const": "flightdeck.weekly/v1"},
    "week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "start": {"type": "string", "format": "date", "description": "Monday of the ISO week, UTC"},
    "end": {"type": "string", "format": "date", "description": "the following Monday (exclusive)"},
    "scope": {
      "type": "object",
      "required": ["person", "repo"],
      "properties": {"person": {"type": ["string", "null"]}, "repo": {"type": ["string", "null"]}}
    },
    "metrics": {"$ref": "#/$defs/metrics"},
    "trailing": {
      "type": "array",
      "description": "The 4 weeks ending with `week`, oldest first",
      "items": {
        "type": "object",
        "required": ["week", "metrics"],
        "properties": {"week": {"type": "string"}, "metrics": {"$ref": "#/$defs/metrics"}}
      }
    }
  },
  "$defs": {
    "count": {"type": ["integer", "null"], "minimum": 0},
    "number": {"type": ["number", "null"]},
    "rate": {
      "type": "object",
      "description": "k of n; rate = k / n with its Wilson 95% interval (null when n = 0)",
      "required": ["k", "n", "rate", "ci95"],
      "properties": {
        "k": {"$ref": "#/$defs/count"},
        "n": {"$ref": "#/$defs/count"},
        "rate": {"$ref": "#/$defs/number"},
        "ci95": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
      }
    },
    "hours": {
      "type": "object",
      "required": ["n", "p50_h", "p90_h"],
      "properties": {"n": {"$ref": "#/$defs/count"}, "p50_h": {"$ref": "#/$defs/number"}, "p90_h": {"$ref": "#/$defs/number"}}
    },
    "value": {
      "type": "object",
      "required": ["value"],
      "properties": {"n": {"$ref": "#/$defs/count"}, "value": {"$ref": "#/$defs/number"}}
    },
    "metrics": {
      "type": "object",
      "required": ["yield", "agent_share", "review_wait", "green_to_merge", "steer_rate", "abandon", "revert",
                   "survival_at_merge", "human_edit_share", "cost_per_merged_pr", "active_delegators", "infra_errors"],
      "properties": {
        "yield": {"$ref": "#/$defs/rate"},
        "agent_share": {"$ref": "#/$defs/rate"},
        "review_wait": {"$ref": "#/$defs/hours"},
        "green_to_merge": {"$ref": "#/$defs/hours"},
        "steer_rate": {"$ref": "#/$defs/value"},
        "abandon": {
          "allOf": [{"$ref": "#/$defs/rate"}],
          "required": ["by_reason"],
          "properties": {"by_reason": {"type": "object", "additionalProperties": {"type": "integer"}}}
        },
        "revert": {"$ref": "#/$defs/rate"},
        "survival_at_merge": {"$ref": "#/$defs/value", "description": "surviving / agent-added lines (KAN-232); n is PRs"},
        "human_edit_share": {"$ref": "#/$defs/value", "description": "merged added lines not the agent's (KAN-232); n is PRs"},
        "cost_per_merged_pr": {"$ref": "#/$defs/value"},
        "active_delegators": {"$ref": "#/$defs/value"},
        "infra_errors": {"$ref": "#/$defs/value"}
      }
    }
  }
}
