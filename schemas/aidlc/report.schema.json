{
  "$defs": {
    "ArmReport": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "enum": [
            "treatment",
            "baseline"
          ],
          "title": "Arm",
          "type": "string"
        },
        "assertions": {
          "items": {
            "$ref": "#/$defs/AssertionResult"
          },
          "title": "Assertions",
          "type": "array"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "cleanup_clean": {
          "title": "Cleanup Clean",
          "type": "boolean"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "limit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        },
        "outcome": {
          "enum": [
            "completed",
            "infrastructure",
            "product",
            "workflow-violation",
            "unavailable",
            "incomplete",
            "not-started"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "scenario": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Scenario",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        }
      },
      "required": [
        "scenario",
        "arm",
        "attempt",
        "outcome",
        "cleanup_clean",
        "metrics",
        "assertions"
      ],
      "title": "ArmReport",
      "type": "object"
    },
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "workflow",
            "correctness",
            "quality"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "expected": {
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "unavailable",
            "pending"
          ],
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "id",
        "dimension",
        "expected",
        "observed",
        "evidence",
        "result"
      ],
      "title": "AssertionResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arms": {
      "items": {
        "$ref": "#/$defs/ArmReport"
      },
      "title": "Arms",
      "type": "array"
    },
    "comparison": {
      "additionalProperties": true,
      "title": "Comparison",
      "type": "object"
    },
    "evidence_kind": {
      "enum": [
        "fixture",
        "live"
      ],
      "title": "Evidence Kind",
      "type": "string"
    },
    "profile": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Profile",
      "type": "string"
    },
    "schema": {
      "const": 1,
      "title": "Schema",
      "type": "integer"
    },
    "suite": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Suite",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "suite",
    "profile",
    "evidence_kind",
    "arms",
    "comparison"
  ],
  "title": "Report",
  "type": "object"
}
